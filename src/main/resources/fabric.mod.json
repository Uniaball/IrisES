{
	"schemaVersion": 1,
	"id": "irises",
	"version": "${version}",
	"name": "IrisES",
	"description": "Lets Iris compile shader packs natively as GLSL ES: keeps the pack's own #version <n> es declaration instead of rewriting it to desktop GL.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/irises/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.uniaball.irises.IrisES"
		]
	},
	"mixins": [
		"irises.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"iris": ">=1.7.3"
	}
}